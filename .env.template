# 将以下内容复制到 .env 文件，并替换为你的新 Supabase 项目配置

# 新的 Supabase 项目 URL (从 https://supabase.com 获取)
TARO_APP_SUPABASE_URL=https://your-project-ref.supabase.co
TARO_APP_SUPABASE_ANON_KEY=your-anon-key-here

# 存储桶名称
TARO_APP_SUPABASE_BUCKET=h5-app

# 应用配置
TARO_APP_NAME=车队管家
TARO_APP_APP_ID=app-7cdqf07mbu9t

# Vite 配置（与上面保持一致）
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key（用于服务端操作，请勿暴露给客户端）
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 数据库直连密码（用于迁移脚本）
SUPABASE_DB_PASSWORD=your-database-password-here
