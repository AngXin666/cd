# Git 属性配置文件
# 统一行尾符和文本文件处理

# 默认行为 - 自动检测文本文件，使用 LF 行尾符
* text=auto eol=lf

# 源代码文件 - 强制文本模式，LF 行尾符
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf

# 配置文件
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.config text eol=lf

# 文档文件
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf

# Web 文件
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf

# 脚本文件
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf
*.py text eol=lf

# 二进制文件 - 不进行文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.apk binary

# 特殊文件
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf
LICENSE text eol=lf
README text eol=lf
