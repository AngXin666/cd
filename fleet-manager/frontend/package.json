{
  "name": "fleet-manager-frontend",
  "version": "1.0.0",
  "description": "车队管家前端 - UniApp (Vue 3 + TypeScript)",
  "scripts": {
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
