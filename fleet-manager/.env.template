# 车队管家环境变量配置模板
# 复制此文件为 .env 并填写实际值
# 
# 使用方法：
#   cp .env.template .env
#   编辑 .env 文件填写实际配置

# ============================================
# 数据库配置
# ============================================
# PostgreSQL 用户名
POSTGRES_USER=fleet

# PostgreSQL 密码（生产环境请使用强密码）
POSTGRES_PASSWORD=fleet123

# PostgreSQL 数据库名
POSTGRES_DB=fleet_manager

# 完整数据库连接 URL（可选，会自动生成）
# DATABASE_URL=postgresql://fleet:fleet123@db:5432/fleet_manager

# ============================================
# JWT 认证配置
# ============================================
# JWT 密钥（生产环境必须更改！使用随机字符串）
# 生成方法：openssl rand -hex 32
JWT_SECRET=your-super-secret-key-change-in-production

# JWT 过期时间（分钟）
JWT_EXPIRE_MINUTES=1440

# ============================================
# 应用配置
# ============================================
# 调试模式（生产环境设为 false）
DEBUG=false

# ============================================
# OCR 配置（百度 OCR - 可选）
# ============================================
# 百度 OCR 应用 ID
BAIDU_OCR_APP_ID=

# 百度 OCR API Key
BAIDU_OCR_API_KEY=

# 百度 OCR Secret Key
BAIDU_OCR_SECRET_KEY=

# ============================================
# SSL 证书配置（生产环境）
# ============================================
# SSL 证书路径（相对于 nginx/ssl 目录）
# SSL_CERT_PATH=fullchain.pem
# SSL_KEY_PATH=privkey.pem
