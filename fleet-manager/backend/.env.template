# 车队管家后端环境变量模板
# 复制此文件为 .env 并填写实际值

# 数据库配置
# 开发环境使用 SQLite
DATABASE_URL=sqlite:///./data/app.db
# 生产环境使用 PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/fleet_manager

# JWT 配置
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 百度 OCR 配置（可选）
BAIDU_OCR_APP_ID=
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=true
