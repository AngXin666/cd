# http://editorconfig.org
# EditorConfig 配置文件 - 统一编码和格式设置
root = true

# 全局配置 - 所有文件
[*]
indent_style = space
indent_size = 2
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown 文件 - 保留尾部空格
[*.md]
trim_trailing_whitespace = false

# JavaScript/TypeScript 文件
[*.{js,ts,jsx,tsx}]
charset = utf-8
end_of_line = lf

# JSON 文件
[*.{json,jsonc}]
charset = utf-8
end_of_line = lf

# YAML 文件
[*.{yml,yaml}]
charset = utf-8
end_of_line = lf

# HTML/CSS/SCSS 文件
[*.{html,css,scss,sass}]
charset = utf-8
end_of_line = lf

# Shell 脚本
[*.sh]
charset = utf-8
end_of_line = lf

# PowerShell 脚本
[*.ps1]
charset = utf-8
end_of_line = lf

# Python 脚本
[*.py]
charset = utf-8
end_of_line = lf
